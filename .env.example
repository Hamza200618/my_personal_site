# GROQ_API_KEY is read ONLY by the serverless function (api/chat.js) — server-side.
# Do NOT prefix it with VITE_. VITE_* variables are bundled into the client
# and would expose the secret in the browser.
#
# Local development:
#   copy .env.example .env   (or: cp .env.example .env)
#   then fill in your real Groq key, e.g.  GROQ_API_KEY=gsk_...
#
# Production (Vercel):
#   Add GROQ_API_KEY in Vercel → Project → Settings → Environment Variables.
#   Create it for Production, Preview, and Development environments.
#
# Never commit the real key.
GROQ_API_KEY=